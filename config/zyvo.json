{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "fallback_models": [
    "zen-public/big-pickle",
    "zen-public/ling-3.1-flash-free",
    "zen-public/deepseek-v4-flash-free",
    "zen-public/fledge-alpha-free",
    "zen-public/longcat-2.5-preview-free"
  ],
  "provider": {
    "zen-public": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Zen (public)",
      "options": {
        "baseURL": "https://opencode.ai/zen/v1",
        "apiKey": "public"
      },
      "models": {
        "big-pickle": {
          "name": "Big Pickle (public)",
          "limit": {
            "context": 200000,
            "input": 160000,
            "output": 32000
          },
          "tool_call": true
        },
        "ling-3.1-flash-free": {
          "name": "Ling 3.1 Flash Free (public)",
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "tool_call": true
        },
        "deepseek-v4-flash-free": {
          "name": "DeepSeek V4 Flash Free (public)",
          "limit": {
            "context": 200000,
            "output": 128000
          },
          "tool_call": true
        },
        "fledge-alpha-free": {
          "name": "Fledge Alpha Free (public)",
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "tool_call": true
        },
        "longcat-2.5-preview-free": {
          "name": "LongCat 2.5 Preview Free (public)",
          "limit": {
            "context": 1000000,
            "output": 131072
          },
          "tool_call": true
        }
      }
    }
  }
}
